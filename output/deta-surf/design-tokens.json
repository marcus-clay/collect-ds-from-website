    "fast": {
      "$value": "0.15s cubic-bezier(0.4, 0, 0.2, 1)",
      "$description": "Quick micro-interaction"
    },
    "default": {
      "$value": "0.2s cubic-bezier(0.4, 0, 0.2, 1)",
      "$description": "Standard ease-in-out transition"
    },
    "slow": {
      "$value": "0.3s cubic-bezier(0.4, 0, 0.2, 1)",
      "$description": "Deliberate transition for larger movements"
    }
