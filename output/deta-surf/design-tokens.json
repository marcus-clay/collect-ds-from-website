      "$description": "Fluid border — card outline"
    },
    "width-fluid-xs": {
      "$value": "clamp(1.8px, 0.18vw, 2.4px)",
      "$type": "dimension",
      "$description": "Fluid border — subtle"
    },
    "inset-depth": {
      "$value": "clamp(3.6px, 0.36vw, 4.8px)",
      "$type": "dimension",
      "$description": "Inset shadow depth on cards"
    }
  },
  "shadow": {
    "card": {
      "$value": "0 clamp(3.6px, 0.36vw, 4.8px) 0 0 #28476110 inset",
      "$type": "shadow",
      "$description": "Default card inset shadow"
    },
    "card-hover": {
      "$value": "0 clamp(3.6px, 0.36vw, 4.8px) 0 0 #28476140 inset",
      "$type": "shadow",
      "$description": "Card inset shadow on hover"
    },
    "card-active": {
      "$value": "0 clamp(3.6px, 0.36vw, 4.8px) 0 0 #0282e8 inset",
      "$type": "shadow",
      "$description": "Card inset shadow when active (pressed)"
    }
  },
